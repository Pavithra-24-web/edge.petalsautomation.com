
# ── App ────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── PostgreSQL (Docker → localhost:5438) ───────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_DB=petaledge
POSTGRES_USER=petaledge
POSTGRES_PASSWORD=changeme-postgres-password

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO / S3 (optional — only when --profile minio) ─────────
S3_ENDPOINT=http://localhost:9007
S3_ACCESS_KEY=changeme-s3-access-key
S3_SECRET_KEY=changeme-s3-secret-key
S3_BUCKET=petaledge
S3_REGION=us-east-1

# ── Auth ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-random-64-char-hex-string
JWT_SECRET=changeme-generate-a-different-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OAuth 2.0 Client ID from Google Cloud Console (Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# verification flow — leave blank unless a server-side OAuth flow is added.
GOOGLE_CLIENT_SECRET=

# ── Email verification (Gmail SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender-address@example.com
SMTP_PASSWORD=changeme-gmail-app-password
SMTP_FROM=your-sender-address@example.com
FRONTEND_URL=http://localhost:3000

# ── ML / Celery ───────────────────────────────────────────────
MAX_TRAINING_WORKERS=2
GPU_ENABLED=true

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_WS_URL=ws://localhost:8010
# Same OAuth client ID as backend's GOOGLE_CLIENT_ID (client IDs are public).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:3002", "http://localhost:8010"]
