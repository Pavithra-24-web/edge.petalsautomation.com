# ── Secrets – never commit real env files ──────────────────────────────────
# Template / example files (safe to commit) are whitelisted below with ! rules.

# All .env variants everywhere in the repo
.env
.env.*
**/.env
**/.env.*
.env.dev

# Explicitly allow example/template env files
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# ── Python ────────────────────────────────────────────────────────────────
